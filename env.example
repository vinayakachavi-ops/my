# Flask Session and Security Secret Key
SECURESHARE_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# Fernet Master Encryption Key (32 url-safe base64-encoded bytes)
# If left unset, SecureShare will automatically generate and safely save a key into .encryption_key
# SECURESHARE_ENCRYPTION_KEY=

# Database Connection (defaults to SQLite instance/secureshare.db)
# DATABASE_URL=sqlite:///instance/secureshare.db

# Flask Environment (development / production)
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
